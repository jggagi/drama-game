[
  {
    "id": "qwen-audition-01",
    "speaker": "旁白",
    "sourceSpeaker": "旁白",
    "text": "十年以后。冬日的光落进一所教会医院。这里从前是周家的宅子。",
    "key": "旁白\n十年以后。冬日的光落进一所教会医院。这里从前是周家的宅子。",
    "sceneId": "prologue",
    "beatIndex": 0,
    "sourceId": "prologue:0",
    "sourceFile": "src/story/script.ts",
    "sourceLine": 16,
    "voiceScriptIndex": 0,
    "direction": "沉静、疏离；“十年以后”后留一拍，平缓打开冬日场景。",
    "existingClip": "/assets/voice/41ae321659dee5dcbbd69c55.mp3",
    "scene": "prologue",
    "sceneTitle": "十年后的医院"
  },
  {
    "id": "qwen-audition-02",
    "speaker": "旁白",
    "sourceSpeaker": "旁白",
    "text": "夏天。周宅的窗紧闭着，闷热像一层没有掀开的布。四凤端着药走进客厅。",
    "key": "旁白\n夏天。周宅的窗紧闭着，闷热像一层没有掀开的布。四凤端着药走进客厅。",
    "sceneId": "medicine",
    "beatIndex": 0,
    "sourceId": "medicine:0",
    "sourceFile": "src/story/first-act.ts",
    "sourceLine": 13,
    "voiceScriptIndex": 11,
    "direction": "语速稍慢，压低声线，读出闷热与屋内压迫感。",
    "existingClip": "/assets/voice/db8d2004884f0f2a4d7ae7a8.mp3",
    "scene": "medicine",
    "sceneTitle": "药碗与家规"
  },
  {
    "id": "qwen-audition-03",
    "speaker": "四凤",
    "sourceSpeaker": "鲁四凤",
    "text": "太太，药煎好了。",
    "key": "四凤\n太太，药煎好了。",
    "sceneId": "medicine",
    "beatIndex": 2,
    "sourceId": "medicine:2",
    "sourceFile": "src/story/first-act.ts",
    "sourceLine": 15,
    "voiceScriptIndex": 13,
    "direction": "年轻、轻声、礼貌；谨慎汇报，不带讨好腔。",
    "existingClip": "/assets/voice/af4500d404f06ac8a959d31b.mp3",
    "scene": "medicine",
    "sceneTitle": "药碗与家规"
  },
  {
    "id": "qwen-audition-04",
    "speaker": "周朴园",
    "sourceSpeaker": "周朴园",
    "text": "既然记得，就把药喝了。不要叫孩子们看着你这样。",
    "key": "周朴园\n既然记得，就把药喝了。不要叫孩子们看着你这样。",
    "sceneId": "medicine",
    "beatIndex": 15,
    "sourceId": "medicine:15",
    "sourceFile": "src/story/first-act.ts",
    "sourceLine": 28,
    "voiceScriptIndex": 26,
    "direction": "低沉克制的命令；句尾落稳，以规矩施压。",
    "existingClip": "/assets/voice/19c0fb541d08b74b35312c62.mp3",
    "scene": "medicine",
    "sceneTitle": "药碗与家规"
  },
  {
    "id": "qwen-audition-05",
    "speaker": "繁漪",
    "sourceSpeaker": "繁漪",
    "text": "我说不喝，就连累全家了？",
    "key": "繁漪\n我说不喝，就连累全家了？",
    "sceneId": "medicine",
    "beatIndex": 19,
    "sourceId": "medicine:19",
    "sourceFile": "src/story/first-act.ts",
    "sourceLine": 32,
    "voiceScriptIndex": 30,
    "direction": "压着怒意反问；重读“不喝”和“全家”，尾音带锋芒。",
    "existingClip": "/assets/voice/a27fe153b04bc0dc4753b568.mp3",
    "scene": "medicine",
    "sceneTitle": "药碗与家规"
  },
  {
    "id": "qwen-audition-06",
    "speaker": "四凤",
    "sourceSpeaker": "鲁四凤",
    "text": "先把字认全。写信的时候，不用总请别人替我写。",
    "key": "四凤\n先把字认全。写信的时候，不用总请别人替我写。",
    "sceneId": "chong",
    "beatIndex": 18,
    "sourceId": "chong:18",
    "sourceFile": "src/story/first-act.ts",
    "sourceLine": 104,
    "voiceScriptIndex": 91,
    "direction": "从谨慎转为小小期待；“不用总请别人”读出自主的愿望。",
    "existingClip": "/assets/voice/fd60ec998c13208277e49c53.mp3",
    "scene": "chong",
    "sceneTitle": "读书与远方"
  },
  {
    "id": "qwen-audition-07",
    "speaker": "周冲",
    "sourceSpeaker": "周冲",
    "text": "以后我们可以去很远的地方。没有人规定我们该站在哪里。",
    "key": "周冲\n以后我们可以去很远的地方。没有人规定我们该站在哪里。",
    "sceneId": "chong",
    "beatIndex": 22,
    "sourceId": "chong:22",
    "sourceFile": "src/story/first-act.ts",
    "sourceLine": 108,
    "voiceScriptIndex": 95,
    "direction": "清亮真诚，向往渐强；少年憧憬，不作昂扬演说。",
    "existingClip": "/assets/voice/35786e799890201607bfc021.mp3",
    "scene": "chong",
    "sceneTitle": "读书与远方"
  },
  {
    "id": "qwen-audition-08",
    "speaker": "周萍",
    "sourceSpeaker": "周萍",
    "text": "我做错过。我没有把错都推给你。",
    "key": "周萍\n我做错过。我没有把错都推给你。",
    "sceneId": "fanyi-ping",
    "beatIndex": 22,
    "sourceId": "fanyi-ping:22",
    "sourceFile": "src/story/first-act.ts",
    "sourceLine": 161,
    "voiceScriptIndex": 138,
    "direction": "低声承认，停顿迟疑；有羞惭，也在艰难划清关系。",
    "existingClip": "/assets/voice/c320eb2a86931595b69800dd.mp3",
    "scene": "fanyi-ping",
    "sceneTitle": "不肯过去的旧事"
  },
  {
    "id": "qwen-audition-09",
    "speaker": "鲁贵",
    "sourceSpeaker": "鲁贵",
    "text": "一家人，还要分得这样清楚？家里哪一样不要钱？",
    "key": "鲁贵\n一家人，还要分得这样清楚？家里哪一样不要钱？",
    "sceneId": "lugui-wages",
    "beatIndex": 8,
    "sourceId": "lugui-wages:8",
    "sourceFile": "src/story/second-act.ts",
    "sourceLine": 21,
    "voiceScriptIndex": 215,
    "direction": "圆滑的责问；先装委屈，再用生活压力逼退对方。",
    "existingClip": "/assets/voice/3c241c1ce903560a9ea28bfe.mp3",
    "scene": "lugui-wages",
    "sceneTitle": "家人与工钱"
  },
  {
    "id": "qwen-audition-10",
    "speaker": "侍萍",
    "sourceSpeaker": "侍萍",
    "text": "你还记得窗。那把她赶到门外的夜里，你也记得么？",
    "key": "侍萍\n你还记得窗。那把她赶到门外的夜里，你也记得么？",
    "sceneId": "old-past",
    "beatIndex": 13,
    "sourceId": "old-past:13",
    "sourceFile": "src/story/second-act.ts",
    "sourceLine": 101,
    "voiceScriptIndex": 284,
    "direction": "疲惫而坚定，第一句冷静；追问逐渐加重，避免哭喊。",
    "existingClip": "/assets/voice/810a7e8eed4352e45a89b55a.mp3",
    "scene": "old-past",
    "sceneTitle": "重逢与旧窗"
  },
  {
    "id": "qwen-audition-11",
    "speaker": "鲁大海",
    "sourceSpeaker": "鲁大海",
    "text": "工钱、安全，还有受伤的人怎么照料，这些都没有说清。那不是我一个人的账。",
    "key": "鲁大海\n工钱、安全，还有受伤的人怎么照料，这些都没有说清。那不是我一个人的账。",
    "sceneId": "strike",
    "beatIndex": 18,
    "sourceId": "strike:18",
    "sourceFile": "src/story/second-act.ts",
    "sourceLine": 167,
    "voiceScriptIndex": 345,
    "direction": "粗粝有力、据理力争；逐项咬清，最后一句坚定有分量。",
    "existingClip": "/assets/voice/8249016be177996714c58312.mp3",
    "scene": "strike",
    "sceneTitle": "罢工与质问"
  },
  {
    "id": "qwen-audition-12",
    "speaker": "四凤",
    "sourceSpeaker": "鲁四凤",
    "text": "我已经有了他的孩子。",
    "key": "四凤\n我已经有了他的孩子。",
    "sceneId": "mother-night",
    "beatIndex": 19,
    "sourceId": "mother-night:19",
    "sourceFile": "src/story/third-act.ts",
    "sourceLine": 163,
    "voiceScriptIndex": 519,
    "direction": "鼓起勇气把秘密说出口；开头轻，后半句坚决，留出话后的沉默。",
    "existingClip": "/assets/voice/bfcecf42911a90e1c0ea2e42.mp3",
    "scene": "mother-night",
    "sceneTitle": "母女雨夜"
  },
  {
    "id": "qwen-audition-13",
    "speaker": "侍萍",
    "sourceSpeaker": "侍萍",
    "text": "我跟你去。不能让你一个人。",
    "key": "侍萍\n我跟你去。不能让你一个人。",
    "sceneId": "mother-night",
    "beatIndex": 39,
    "sourceId": "mother-night:39",
    "sourceFile": "src/story/third-act.ts",
    "sourceLine": 183,
    "voiceScriptIndex": 539,
    "direction": "焦虑后作出决定；温柔但落字坚实，以陪伴护住女儿。",
    "existingClip": "/assets/voice/a65b0c53538cd79fb6cbe523.mp3",
    "scene": "mother-night",
    "sceneTitle": "母女雨夜"
  },
  {
    "id": "qwen-audition-14",
    "speaker": "繁漪",
    "sourceSpeaker": "繁漪",
    "text": "叫我别提以前，别叫你，别见你。你每句话都只叫我别做什么。",
    "key": "繁漪\n叫我别提以前，别叫你，别见你。你每句话都只叫我别做什么。",
    "sceneId": "confrontation",
    "beatIndex": 21,
    "sourceId": "confrontation:21",
    "sourceFile": "src/story/fourth-act.ts",
    "sourceLine": 53,
    "voiceScriptIndex": 576,
    "direction": "受伤转为质问；三个“别”逐层递进，后一句情绪逼近失控。",
    "existingClip": "/assets/voice/546d37bd92d646ac618a92bd.mp3",
    "scene": "confrontation",
    "sceneTitle": "雨夜对峙"
  },
  {
    "id": "qwen-audition-15",
    "speaker": "周朴园",
    "sourceSpeaker": "周朴园",
    "text": "她就是你的母亲。你的亲生母亲。",
    "key": "周朴园\n她就是你的母亲。你的亲生母亲。",
    "sceneId": "revelation",
    "beatIndex": 7,
    "sourceId": "revelation:7",
    "sourceFile": "src/story/fourth-act.ts",
    "sourceLine": 76,
    "voiceScriptIndex": 594,
    "direction": "郑重而生硬地宣布；第二句减速重读“亲生”，仍带家长权威。",
    "existingClip": "/assets/voice/54ae88e7bd27a6e23224716f.mp3",
    "scene": "revelation",
    "sceneTitle": "血缘揭露"
  },
  {
    "id": "qwen-audition-16",
    "speaker": "周萍",
    "sourceSpeaker": "周萍",
    "text": "我们不知道。没人告诉过我们。",
    "key": "周萍\n我们不知道。没人告诉过我们。",
    "sceneId": "revelation",
    "beatIndex": 25,
    "sourceId": "revelation:25",
    "sourceFile": "src/story/fourth-act.ts",
    "sourceLine": 94,
    "voiceScriptIndex": 612,
    "direction": "震惊中急切申辩，声音发紧；第二句近乎失力，不哭喊。",
    "existingClip": "/assets/voice/f6a16e4277692abb4f1bd8b1.mp3",
    "scene": "revelation",
    "sceneTitle": "血缘揭露"
  },
  {
    "id": "qwen-audition-17",
    "speaker": "旁白",
    "sourceSpeaker": "旁白",
    "text": "她听不清屋里的回答。只看见门缝外一条亮着的雨。",
    "key": "旁白\n她听不清屋里的回答。只看见门缝外一条亮着的雨。",
    "sceneId": "revelation",
    "beatIndex": 31,
    "sourceId": "revelation:31",
    "sourceFile": "src/story/fourth-act.ts",
    "sourceLine": 100,
    "voiceScriptIndex": 618,
    "direction": "放轻、放慢，声音像退到远处；突出骤然失聪般的恍惚。",
    "existingClip": "/assets/voice/13c512264092bce475b823ec.mp3",
    "scene": "revelation",
    "sceneTitle": "血缘揭露"
  },
  {
    "id": "qwen-audition-18",
    "speaker": "侍萍",
    "sourceSpeaker": "侍萍",
    "text": "你问为什么，我没敢说。这是我的错。",
    "key": "侍萍\n你问为什么，我没敢说。这是我的错。",
    "sceneId": "adapt-pause",
    "beatIndex": 7,
    "sourceId": "adapt-pause:7",
    "sourceFile": "src/story/fourth-act.ts",
    "sourceLine": 162,
    "voiceScriptIndex": 657,
    "direction": "正视女儿、诚恳认错；不辩解，末句低而明确。",
    "existingClip": "/assets/voice/95d4fc951e217d2da262912d.mp3",
    "scene": "adapt-pause",
    "sceneTitle": "母亲的认错"
  },
  {
    "id": "qwen-audition-19",
    "speaker": "四凤",
    "sourceSpeaker": "鲁四凤",
    "text": "我得先想想。你别把这笔钱算成我已经答应了。",
    "key": "四凤\n我得先想想。你别把这笔钱算成我已经答应了。",
    "sceneId": "adapt-boundaries",
    "beatIndex": 19,
    "sourceId": "adapt-boundaries:19",
    "sourceFile": "src/story/fourth-act.ts",
    "sourceLine": 197,
    "voiceScriptIndex": 685,
    "direction": "疲惫中保持清醒；稍慢但坚定，强调自己的选择权。",
    "existingClip": "/assets/voice/fb787fc7c7f78fcd3eed8ab6.mp3",
