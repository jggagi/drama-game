    {
      "id": "qwen-audition-01",
      "speaker": "旁白",
      "text": "十年以后。冬日的光落进一所教会医院。这里从前是周家的宅子。",
      "direction": "沉静、疏离；“十年以后”后留一拍，平缓打开冬日场景。",
      "scene": "prologue",
      "sceneTitle": "十年后的医院",
      "voice": "Vincent",
      "targetAge": "45–55岁",
      "voiceProfile": "中年男声 · 低沉微哑、沧桑克制",
      "gender": "male",
      "src": "/assets/qwen-audition/49a7d26429b51ee1da07b6d8.mp3",
      "duration": 8.0,
      "originalSrc": "/assets/voice/41ae321659dee5dcbbd69c55.mp3",
      "originalDuration": 5.726
    },
    {
      "id": "qwen-audition-02",
      "speaker": "旁白",
      "text": "夏天。周宅的窗紧闭着，闷热像一层没有掀开的布。四凤端着药走进客厅。",
      "direction": "语速稍慢，压低声线，读出闷热与屋内压迫感。",
      "scene": "medicine",
      "sceneTitle": "药碗与家规",
      "voice": "Vincent",
      "targetAge": "45–55岁",
      "voiceProfile": "中年男声 · 低沉微哑、沧桑克制",
      "gender": "male",
      "src": "/assets/qwen-audition/6791b2b4e650db29492e4bb2.mp3",
      "duration": 10.88,
      "originalSrc": "/assets/voice/db8d2004884f0f2a4d7ae7a8.mp3",
      "originalDuration": 6.755
    },
    {
      "id": "qwen-audition-03",
      "speaker": "四凤",
      "text": "太太，药煎好了。",
      "direction": "年轻、轻声、礼貌；谨慎汇报，不带讨好腔。",
      "scene": "medicine",
      "sceneTitle": "药碗与家规",
      "voice": "Serena",
      "targetAge": "18岁",
      "voiceProfile": "清澈朴素 · 谨慎、有主见",
      "gender": "female",
      "src": "/assets/qwen-audition/eed0c52098fa06146895f320.mp3",
      "duration": 1.76,
      "originalSrc": "/assets/voice/af4500d404f06ac8a959d31b.mp3",
      "originalDuration": 1.588
    },
    {
      "id": "qwen-audition-04",
      "speaker": "周朴园",
      "text": "既然记得，就把药喝了。不要叫孩子们看着你这样。",
      "direction": "低沉克制的命令；句尾落稳，以规矩施压。",
      "scene": "medicine",
      "sceneTitle": "药碗与家规",
      "voice": "Eldric Sage",
      "targetAge": "55岁",
      "voiceProfile": "结实低音 · 端持、惯于掌控",
      "gender": "male",
      "src": "/assets/qwen-audition/44945b08afd7fa6841a654cb.mp3",
      "duration": 7.28,
      "originalSrc": "/assets/voice/19c0fb541d08b74b35312c62.mp3",
      "originalDuration": 4.023
    },
    {
      "id": "qwen-audition-05",
      "speaker": "繁漪",
      "text": "我说不喝，就连累全家了？",
      "direction": "压着怒意反问；重读“不喝”和“全家”，尾音带锋芒。",
      "scene": "medicine",
      "sceneTitle": "药碗与家规",
      "voice": "Bellona",
      "targetAge": "35岁",
      "voiceProfile": "饱满清晰 · 体面下的压抑与锋芒",
      "gender": "female",
      "src": "/assets/qwen-audition/94f5b2d555181f0bb1f2e143.mp3",
      "duration": 2.96,
      "originalSrc": "/assets/voice/a27fe153b04bc0dc4753b568.mp3",
      "originalDuration": 2.515
    },
    {
      "id": "qwen-audition-06",
      "speaker": "四凤",
      "text": "先把字认全。写信的时候，不用总请别人替我写。",
      "direction": "从谨慎转为小小期待；“不用总请别人”读出自主的愿望。",
      "scene": "chong",
      "sceneTitle": "读书与远方",
      "voice": "Serena",
      "targetAge": "18岁",
      "voiceProfile": "清澈朴素 · 谨慎、有主见",
      "gender": "female",
      "src": "/assets/qwen-audition/7c242b875b8fedd026a5de8d.mp3",
      "duration": 4.0,
      "originalSrc": "/assets/voice/fd60ec998c13208277e49c53.mp3",
      "originalDuration": 4.475
    },
    {
      "id": "qwen-audition-07",
      "speaker": "周冲",
      "text": "以后我们可以去很远的地方。没有人规定我们该站在哪里。",
      "direction": "清亮真诚，向往渐强；少年憧憬，不作昂扬演说。",
      "scene": "chong",
      "sceneTitle": "读书与远方",
      "voice": "Ethan",
      "targetAge": "17岁",
      "voiceProfile": "清朗少年 · 理想、真诚与试探",
      "gender": "male",
      "src": "/assets/qwen-audition/279c6d66401aafc56def2e71.mp3",
      "duration": 4.08,
      "originalSrc": "/assets/voice/35786e799890201607bfc021.mp3",
      "originalDuration": 4.67
    },
    {
      "id": "qwen-audition-08",
      "speaker": "周萍",
      "text": "我做错过。我没有把错都推给你。",
      "direction": "低声承认，停顿迟疑；有羞惭，也在艰难划清关系。",
      "scene": "fanyi-ping",
      "sceneTitle": "不肯过去的旧事",
      "voice": "Moon",
      "targetAge": "28岁",
      "voiceProfile": "温和中音 · 不安、负罪与逃避",
      "gender": "male",
      "src": "/assets/qwen-audition/cbafe30f9ec9516ee455e158.mp3",
      "duration": 3.6,
      "originalSrc": "/assets/voice/c320eb2a86931595b69800dd.mp3",
      "originalDuration": 2.643
    },
    {
      "id": "qwen-audition-09",
      "speaker": "鲁贵",
      "text": "一家人，还要分得这样清楚？家里哪一样不要钱？",
      "direction": "圆滑的责问；先装委屈，再用生活压力逼退对方。",
      "scene": "lugui-wages",
      "sceneTitle": "家人与工钱",
      "voice": "qwen-tts-vd-menwai_lugui48-voice-20261004184450089-a61d",
      "targetAge": "48岁",
      "voiceProfile": "中年略哑 · 世故、市侩与算计",
      "gender": "male",
      "src": "/assets/qwen-audition/479df8f6a659963f6ef8937e.mp3",
      "duration": 5.04,
      "originalSrc": "/assets/voice/3c241c1ce903560a9ea28bfe.mp3",
      "originalDuration": 4.351
    },
    {
      "id": "qwen-audition-10",
      "speaker": "侍萍",
      "text": "你还记得窗。那把她赶到门外的夜里，你也记得么？",
      "direction": "疲惫而坚定，第一句冷静；追问逐渐加重，避免哭喊。",
      "scene": "old-past",
      "sceneTitle": "重逢与旧窗",
