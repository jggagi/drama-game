      "duration": 5.12,
      "originalSrc": "/assets/voice/810a7e8eed4352e45a89b55a.mp3",
      "originalDuration": 5.162
    },
    {
      "id": "qwen-audition-11",
      "speaker": "鲁大海",
      "text": "工钱、安全，还有受伤的人怎么照料，这些都没有说清。那不是我一个人的账。",
      "direction": "粗粝有力、据理力争；逐项咬清，最后一句坚定有分量。",
      "scene": "strike",
      "sceneTitle": "罢工与质问",
      "voice": "Nofish",
      "targetAge": "27岁",
      "voiceProfile": "结实粗粝 · 直接、愤怒而有条理",
      "gender": "male",
      "src": "/assets/qwen-audition/c5aa4b9bbb4731a4262729ac.mp3",
      "duration": 5.92,
      "originalSrc": "/assets/voice/8249016be177996714c58312.mp3",
      "originalDuration": 6.147
    },
    {
      "id": "qwen-audition-12",
      "speaker": "四凤",
      "text": "我已经有了他的孩子。",
      "direction": "鼓起勇气把秘密说出口；开头轻，后半句坚决，留出话后的沉默。",
      "scene": "mother-night",
      "sceneTitle": "母女雨夜",
      "voice": "Serena",
      "targetAge": "18岁",
      "voiceProfile": "清澈朴素 · 谨慎、有主见",
      "gender": "female",
      "src": "/assets/qwen-audition/7f2fee26f7d20bc1e58de552.mp3",
      "duration": 1.76,
      "originalSrc": "/assets/voice/bfcecf42911a90e1c0ea2e42.mp3",
      "originalDuration": 1.844
    },
    {
      "id": "qwen-audition-13",
      "speaker": "侍萍",
      "text": "我跟你去。不能让你一个人。",
      "direction": "焦虑后作出决定；温柔但落字坚实，以陪伴护住女儿。",
      "scene": "mother-night",
      "sceneTitle": "母女雨夜",
      "voice": "qwen-tts-vd-menwai_shiping47-voice-20261004184442590-ccc3",
      "targetAge": "47岁",
      "voiceProfile": "成熟中低音 · 经历磨砺、护女坚定",
      "gender": "female",
      "src": "/assets/qwen-audition/8695103c17f1bfc7195ed32b.mp3",
      "duration": 2.56,
      "originalSrc": "/assets/voice/a65b0c53538cd79fb6cbe523.mp3",
      "originalDuration": 2.941
    },
    {
      "id": "qwen-audition-14",
      "speaker": "繁漪",
      "text": "叫我别提以前，别叫你，别见你。你每句话都只叫我别做什么。",
      "direction": "受伤转为质问；三个“别”逐层递进，后一句情绪逼近失控。",
      "scene": "confrontation",
      "sceneTitle": "雨夜对峙",
      "voice": "Bellona",
      "targetAge": "35岁",
      "voiceProfile": "饱满清晰 · 体面下的压抑与锋芒",
      "gender": "female",
      "src": "/assets/qwen-audition/bbb389c951e3e3aaa20db634.mp3",
      "duration": 6.48,
      "originalSrc": "/assets/voice/546d37bd92d646ac618a92bd.mp3",
      "originalDuration": 5.465
    },
    {
      "id": "qwen-audition-15",
      "speaker": "周朴园",
      "text": "她就是你的母亲。你的亲生母亲。",
      "direction": "郑重而生硬地宣布；第二句减速重读“亲生”，仍带家长权威。",
      "scene": "revelation",
      "sceneTitle": "血缘揭露",
      "voice": "Eldric Sage",
      "targetAge": "55岁",
      "voiceProfile": "结实低音 · 端持、惯于掌控",
      "gender": "male",
      "src": "/assets/qwen-audition/c7377df24b62cc4b62bafe25.mp3",
      "duration": 6.88,
      "originalSrc": "/assets/voice/54ae88e7bd27a6e23224716f.mp3",
      "originalDuration": 2.863
    },
    {
      "id": "qwen-audition-16",
      "speaker": "周萍",
      "text": "我们不知道。没人告诉过我们。",
      "direction": "震惊中急切申辩，声音发紧；第二句近乎失力，不哭喊。",
      "scene": "revelation",
      "sceneTitle": "血缘揭露",
      "voice": "Moon",
      "targetAge": "28岁",
      "voiceProfile": "温和中音 · 不安、负罪与逃避",
      "gender": "male",
      "src": "/assets/qwen-audition/cb4b1c90183d4ca1f65a21a0.mp3",
      "duration": 2.88,
      "originalSrc": "/assets/voice/f6a16e4277692abb4f1bd8b1.mp3",
      "originalDuration": 2.431
    },
    {
      "id": "qwen-audition-17",
      "speaker": "旁白",
      "text": "她听不清屋里的回答。只看见门缝外一条亮着的雨。",
      "direction": "放轻、放慢，声音像退到远处；突出骤然失聪般的恍惚。",
      "scene": "revelation",
      "sceneTitle": "血缘揭露",
      "voice": "Vincent",
      "targetAge": "45–55岁",
      "voiceProfile": "中年男声 · 低沉微哑、沧桑克制",
      "gender": "male",
      "src": "/assets/qwen-audition/e6b6abf2d6ea4f4afdbb3b69.mp3",
      "duration": 5.76,
      "originalSrc": "/assets/voice/13c512264092bce475b823ec.mp3",
      "originalDuration": 4.275
    },
    {
      "id": "qwen-audition-18",
      "speaker": "侍萍",
      "text": "你问为什么，我没敢说。这是我的错。",
      "direction": "正视女儿、诚恳认错；不辩解，末句低而明确。",
      "scene": "adapt-pause",
      "sceneTitle": "母亲的认错",
      "voice": "qwen-tts-vd-menwai_shiping47-voice-20261004184442590-ccc3",
